# ========================================
# 环境变量配置 - 复制此文件为 .env 并填入真实值
# ========================================

# LLM API 密钥
LLM_API_KEY=your-api-key-here

# LLM API 基础URL (可选，默认使用settings.yaml中的配置)
# LLM_API_BASE=https://api.deepseek.com

# 代理设置 (可选)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
